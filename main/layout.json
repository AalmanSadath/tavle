{
  "sources": {
    "printer": {
      "type": "moonraker",
      "host": "printer.local",
      "port": 7125
    }
  },
  "screens": [
    {
      "name": "printer",
      "widgets": [
        {
          "type": "progress",
          "col": 0,
          "row": 0,
          "colspan": 3,
          "label": "Progress",
          "source": "printer",
          "path": "virtual_sdcard.progress"
        },
        {
          "type": "graph",
          "col": 0,
          "row": 1,
          "colspan": 3,
          "label": "Nozzle",
          "source": "printer",
          "path": "extruder.temperature",
          "min": 0,
          "max": 260,
          "period": 10
        },
        {
          "type": "value",
          "col": 0,
          "row": 2,
          "label": "Nozzle",
          "source": "printer",
          "path": "extruder.temperature",
          "unit": "°C",
          "format": "%.0f"
        },
        {
          "type": "value",
          "col": 1,
          "row": 2,
          "label": "Bed",
          "source": "printer",
          "path": "heater_bed.temperature",
          "unit": "°C",
          "format": "%.0f"
        },
        {
          "type": "icon",
          "col": 2,
          "row": 2,
          "source": "printer",
          "path": "print_stats.state"
        },
        {
          "type": "text",
          "col": 0,
          "row": 3,
          "colspan": 2,
          "label": "File",
          "source": "printer",
          "path": "print_stats.filename"
        },
        {
          "type": "clock",
          "col": 2,
          "row": 3,
          "format": "%H:%M"
        }
      ]
    }
  ]
}
