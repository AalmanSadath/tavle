{
  "sources": {
    "printer": {
      "type": "moonraker",
      "host": "printer.local",
      "port": 7125
    }
  },
  "screens": [
    {
      "name": "printer",
      "widgets": [
        {
          "type": "progress",
          "col": 0,
          "row": 0,
          "colspan": 3,
          "label": "Progress",
          "source": "printer",
          "path": "tavle.progress",
          "text_path": "tavle.filename"
        },
        {
          "type": "graph",
          "col": 0,
          "row": 1,
          "colspan": 3,
          "source": "printer",
          "paths": [
            "extruder.temperature",
            "heater_bed.temperature"
          ],
          "labels": [
            "nozzle",
            "bed"
          ],
          "min": 0,
          "max": 260,
          "period": 10
        },
        {
          "type": "value",
          "col": 0,
          "row": 2,
          "label": "Nozzle",
          "source": "printer",
          "path": "extruder.temperature",
          "unit": "°C",
          "format": "%.0f"
        },
        {
          "type": "value",
          "col": 1,
          "row": 2,
          "label": "Bed",
          "source": "printer",
          "path": "heater_bed.temperature",
          "unit": "°C",
          "format": "%.0f"
        },
        {
          "type": "value",
          "col": 2,
          "row": 2,
          "label": "Layer",
          "source": "printer",
          "path": "tavle.layer"
        },
        {
          "type": "value",
          "col": 0,
          "row": 3,
          "label": "Slicer ETA",
          "source": "printer",
          "path": "tavle.slicer_remaining",
          "format": "duration"
        },
        {
          "type": "value",
          "col": 1,
          "row": 3,
          "label": "Klipper ETA",
          "source": "printer",
          "path": "tavle.klipper_remaining",
          "format": "duration"
        },
        {
          "type": "value",
          "col": 2,
          "row": 3,
          "label": "Elapsed",
          "source": "printer",
          "path": "print_stats.print_duration",
          "format": "duration"
        }
      ]
    }
  ]
}
