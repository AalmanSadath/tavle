# Settings shared by every board. Board settings: boards/<board>/sdkconfig.defaults

# Size over speed: saves ~155 KB of flash and ~7 KB of RAM for ~10% of frame rate
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_QRCODE=y

# Firmware updates
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Setup page: room for the Authorization header
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# TLS for https layout URLs: buffers only while a connection is open, and the
# common CA bundle instead of the full one
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
