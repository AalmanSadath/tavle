# ESP32-S3-WROOM-1 N16R8: 16 MB quad flash, 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_TAVLE_BOARD_S3=y
CONFIG_TAVLE_DISPLAY_ST7796=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/s3/partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Console on UART0, with USB Serial/JTAG as a second console
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Octal PSRAM; malloc may place larger blocks there, and Wi-Fi and lwIP may too
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_TAVLE_WIFI_TX_POWER_QDBM=0

# Four sources, a picture, an HTTPS fetch and the setup page at once
CONFIG_LWIP_MAX_SOCKETS=16
