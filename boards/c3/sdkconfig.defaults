# ESP32-C3, 4 MB flash, no PSRAM
CONFIG_IDF_TARGET="esp32c3"
CONFIG_TAVLE_BOARD_C3=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The chip antenna on this board only works with reduced transmit power (8.5 dBm)
CONFIG_TAVLE_WIFI_TX_POWER_QDBM=34

# Wi-Fi buffers, sized down to leave RAM for TLS
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
